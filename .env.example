# Public build-time values only. Never put passwords, tokens or private keys here.
# Production: empty = same HTTPS origin as the frontend.
VITE_API_URL=

# Empty uses VITE_API_URL + /api/v1/delegados through the authenticated backend.
VITE_DLGA_API_URL=
VITE_DLGA_PUBLIC_URL=

# Exact HTTPS IdP origins permitted for SAML logout redirects, comma-separated.
# Populate from the actual SAML configuration; no wildcards.
VITE_AUTH_REDIRECT_ORIGINS=

# Leave both empty to use the version and SRI pinned in the repository.
VITE_AUTOFIRMA_SCRIPT_URL=
VITE_AUTOFIRMA_SCRIPT_INTEGRITY=
